{
  "version": 2,
  "builds": [
    { "src": "api/index.php", "use": "vercel-php@0.7.4" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(css|js|images|fonts)/(.*)", "dest": "public/$1/$2" },
    { "src": "/(.*)", "dest": "api/index.php" }
  ],
  "functions": {
    "api/index.php": {
      "excludeFiles": "{tests,node_modules,.git,storage/logs,storage/framework/cache,storage/framework/sessions,storage/framework/views}/**"
    }
  },
  "env": {
    "COMPOSER_NO_DEV": "1",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/services.php",
    "VIEW_COMPILED_PATH": "/tmp/views",
    "CACHE_DRIVER": "array",
    "SESSION_DRIVER": "cookie",
    "LOG_CHANNEL": "stderr",
    "DB_CONNECTION": "sqlite",
    "DB_DATABASE": "/tmp/database.sqlite"
  }
}
